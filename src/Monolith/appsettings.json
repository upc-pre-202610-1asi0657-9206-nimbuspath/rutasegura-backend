{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "TokenSettings": {
    "Secret": "",
    "Issuer": "rutasegura-iam",
    "Audience": "rutasegura-api",
    "ExpirationHours": 8
  },
  "Iam": {
    "Provisioning": {
      "ApiKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000"
    ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Administration": {
    "Plans": {
      "Default": {
        "PlanCode": "BASIC",
        "MaxActiveRoutes": 3
      },
      "Organizations": {}
    },
    "Messaging": {
      "Enabled": false,
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ClientName": "monolith-administration",
      "EventsExchange": "administration.events",
      "InboundQueue": "administration.inbound",
      "PrefetchCount": 20
    }
  }
}
