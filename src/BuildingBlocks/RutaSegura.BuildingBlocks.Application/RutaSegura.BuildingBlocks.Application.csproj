<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Abstracciones de la capa de aplicación compartidas (5.1.3): CQRS con despachador propio
    (sin MediatR por licencia), Result, validación y decoradores Logging → Validation → Transaction.
    Solo depende de abstracciones de Microsoft.Extensions (nada de ASP.NET ni EF).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RutaSegura.BuildingBlocks.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RutaSegura.BuildingBlocks.Domain\RutaSegura.BuildingBlocks.Domain.csproj" Condition="'$(UseBuildingBlockPackages)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBuildingBlockPackages)' == 'true'">
    <PackageReference Include="RutaSegura.BuildingBlocks.Domain" Version="$(BuildingBlocksVersion)" />
  </ItemGroup>
</Project>
