{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NotificationProxy": { "Enabled": false },
  "Jwt": { "Secret": "", "Issuer": "", "Audience": "" },
  "Cors": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "notification-inbox": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/notifications/{**remainder}" }
      },
      "notification-announcements": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/announcements/{**remainder}" }
      },
      "notification-push": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/push-subscriptions/{**remainder}" }
      },
      "notification-hub": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/hubs/notifications/{**remainder}" }
      }
    },
    "Clusters": {
      "notification": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": { "primary": { "Address": "http://localhost:5182/" } }
      }
    }
  }
}
