{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "TrustForwardedHeaders": false,
    "MaxRequestBodyBytes": 2097152,
    "SignInRateLimit": { "PermitLimit": 10, "Window": "00:01:00" },
    "Readiness": {
      "monolith": "/health",
      "trip-tracking": "/health/live",
      "notification": "/health/ready"
    },
    "ReadinessTimeout": "00:00:03"
  },
  "NotificationProxy": { "Enabled": false },
  "Jwt": { "Secret": "", "Issuer": "", "Audience": "" },
  "Cors": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "iam-sign-in": {
        "ClusterId": "monolith",
        "RateLimiterPolicy": "sign-in",
        "Match": { "Path": "/api/v1/users/sign-in", "Methods": [ "POST" ] }
      },
      "iam-sign-up": {
        "ClusterId": "monolith",
        "RateLimiterPolicy": "sign-in",
        "Match": { "Path": "/api/v1/users", "Methods": [ "POST" ] }
      },
      "iam-users": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/users/{**remainder}" }
      },
      "iam-organizations": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/organizations/{**remainder}", "Methods": [ "GET", "PUT" ] }
      },
      "administration-roster": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/roster/{**remainder}" }
      },
      "administration-routes": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/routes/{**remainder}" }
      },
      "administration-operations": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/operations/{**remainder}" }
      },
      "stakeholder": {
        "ClusterId": "monolith",
        "Match": { "Path": "/api/v1/stakeholders/{**remainder}" }
      },
      "trip-tracking-trips": {
        "ClusterId": "trip-tracking",
        "Match": { "Path": "/api/v1/trips/{**remainder}" }
      },
      "trip-tracking-positions": {
        "ClusterId": "trip-tracking",
        "Match": { "Path": "/api/v1/tracking/{**remainder}" }
      },
      "trip-tracking-drivers": {
        "ClusterId": "trip-tracking",
        "Match": { "Path": "/api/v1/drivers/{**remainder}" }
      },
      "trip-tracking-guardians": {
        "ClusterId": "trip-tracking",
        "Match": { "Path": "/api/v1/guardians/{**remainder}" }
      },
      "trip-tracking-hub": {
        "ClusterId": "trip-tracking",
        "Match": { "Path": "/hubs/trip-tracking/{**remainder}" }
      },
      "notification-inbox": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/notifications/{**remainder}" }
      },
      "notification-announcements": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/announcements/{**remainder}" }
      },
      "notification-push": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/api/v1/push-subscriptions/{**remainder}" }
      },
      "notification-hub": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "notification-proxy",
        "Match": { "Path": "/hubs/notifications/{**remainder}" }
      }
    },
    "Clusters": {
      "monolith": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": { "primary": { "Address": "http://localhost:5000/" } }
      },
      "trip-tracking": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": { "primary": { "Address": "http://localhost:5180/" } }
      },
      "notification": {
        "HttpRequest": { "ActivityTimeout": "00:02:00" },
        "Destinations": { "primary": { "Address": "http://localhost:5182/" } }
      }
    }
  }
}
