    "Queue": "notification.trip-events.v1"
  },
  "NotificationDependencies": {
    "Administration": { "BaseUrl": "", "ServiceToken": "", "AllowInsecureHttp": false },
    "TripTracking": { "BaseUrl": "", "ServiceToken": "", "AllowInsecureHttp": false }
  }
