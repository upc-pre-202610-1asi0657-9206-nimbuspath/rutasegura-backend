{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NotificationApi": { "Enabled": false },
  "NotificationChannels": { "Enabled": false, "BatchSize": 50, "MaxAttempts": 5, "MaxConcurrency": 4, "PollingInterval": "00:00:01" },
  "NotificationFcm": { "Enabled": false, "ProjectId": "" },
  "NotificationRealtime": { "RedisConnection": "" },
  "Jwt": { "Secret": "", "Issuer": "", "Audience": "" },
  "Iam": { "BaseUrl": "", "AllowInsecureHttp": false, "AccountValidation": { "Enabled": true, "Timeout": "00:00:03" } },
  "Cors": { "AllowedOrigins": [] },
  "ConnectionStrings": {
    "NotificationDatabase": ""
  },
  "NotificationPersistence": {
