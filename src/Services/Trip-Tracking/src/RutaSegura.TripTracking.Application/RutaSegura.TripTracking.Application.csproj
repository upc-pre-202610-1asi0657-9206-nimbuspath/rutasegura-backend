<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Casos de uso del hexágono. Define los PUERTOS de salida (repositorios, publicador en tiempo real,
    directorios de otros contextos) que Infrastructure implementa con MySQL / RabbitMQ.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RutaSegura.TripTracking.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RutaSegura.TripTracking.Domain\RutaSegura.TripTracking.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\BuildingBlocks\RutaSegura.BuildingBlocks.Application\RutaSegura.BuildingBlocks.Application.csproj" Condition="'$(UseBuildingBlockPackages)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RutaSegura.TripTracking.Application.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseBuildingBlockPackages)' == 'true'">
    <PackageReference Include="RutaSegura.BuildingBlocks.Application" Version="$(BuildingBlocksVersion)" />
  </ItemGroup>
</Project>
