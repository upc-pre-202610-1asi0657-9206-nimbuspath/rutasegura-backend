{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TripTracking": "server=localhost;port=3306;database=rutasegura_trip_tracking;user=rutasegura;password=rutasegura",
    "Redis": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "rutasegura-iam",
    "Audience": "rutasegura-api"
  },
  "Iam": {
    "BaseUrl": "http://localhost:5000",
    "AccountValidation": {
      "Enabled": true,
      "AccountPath": "/api/v1/users/me",
      "CacheDuration": "00:01:00",
      "UnavailableCacheDuration": "00:00:05",
      "Timeout": "00:00:03",
      "WhenUnavailable": "Allow"
    }
  },
  "Persistence": {
    "MigrateOnStartup": false
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "EventsExchange": "trip-tracking.events",
    "LiveExchange": "trip-tracking.live",
    "InboundQueue": "trip-tracking.inbound",
    "PrefetchCount": 20,
    "InboundBindings": [
      { "Exchange": "administration.events", "RoutingKey": "*.route-published" },
      { "Exchange": "administration.events", "RoutingKey": "*.route-updated" },
      { "Exchange": "administration.events", "RoutingKey": "*.route-retired" },
      { "Exchange": "administration.events", "RoutingKey": "*.guardian-student-linked" },
      { "Exchange": "administration.events", "RoutingKey": "*.guardian-student-unlinked" },
      { "Exchange": "iam.events", "RoutingKey": "*.guardian-student-linked" },
      { "Exchange": "iam.events", "RoutingKey": "*.guardian-student-unlinked" }
    ]
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 50,
    "MaxBackoff": "00:05:00",
    "Retention": "7.00:00:00"
  },
  "LivePositions": {
    "CacheTtl": "00:30:00"
  },
  "Scheduling": {
    "Enabled": true,
    "Interval": "00:30:00",
    "DaysAhead": 1
  },
  "Seed": {
    "Demo": false
  },
  "DevTokens": {
    "Enabled": false
  }
}
