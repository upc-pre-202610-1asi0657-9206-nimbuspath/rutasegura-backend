<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de integración del bounded context Administration dentro del monolito: host real (Program.cs),
    HTTP + seguridad de Iam + EF Core (SQLite en memoria con el mismo modelo) + Outbox/Inbox.
    No requieren MySQL ni RabbitMQ.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RutaSegura.Monolith.Administration.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Monolith/Monolith.csproj" />
  </ItemGroup>

</Project>
