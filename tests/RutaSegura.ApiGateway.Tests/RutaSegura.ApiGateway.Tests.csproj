<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas del API Gateway (YARP) como punto de entrada único:
      - Enrutamiento: servicios "eco" en memoria muestran a qué servicio llegó cada ruta y qué cabeceras recibió.
      - De punta a punta: Gateway → monolito real (Iam + Administration, SQLite en memoria) y Trip & Tracking real
        (casos de uso sustituidos, sin MySQL). Los tokens los emite Iam a través del Gateway.
    No requieren Docker. Cada host define "Program": se referencian con alias (gateway, monolith).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RutaSegura.ApiGateway.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ApiGateway/RutaSegura.ApiGateway.csproj" Aliases="gateway" />
    <ProjectReference Include="../../src/Monolith/Monolith.csproj" Aliases="monolith" />
    <ProjectReference Include="../../src/Services/Trip-Tracking/src/RutaSegura.TripTracking.Api/RutaSegura.TripTracking.Api.csproj" />
  </ItemGroup>

</Project>
