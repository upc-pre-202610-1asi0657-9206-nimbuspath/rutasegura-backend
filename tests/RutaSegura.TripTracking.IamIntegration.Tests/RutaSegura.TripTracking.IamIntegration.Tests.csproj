<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integración real de la seguridad de Iam con Trip & Tracking: el monolito (Iam) y Trip & Tracking corren
    juntos en memoria. Iam emite los tokens (sign-in) y Trip & Tracking los valida y le pregunta a Iam por la cuenta
    (GET /api/v1/users/me) a través del TestServer del monolito. Iam usa SQLite en memoria con su mismo modelo;
    los casos de uso de Trip & Tracking se sustituyen para no necesitar MySQL. No requieren Docker.

    Ambos hosts definen "Program": el monolito se referencia con el alias "monolith" (extern alias monolith;).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RutaSegura.TripTracking.IamIntegration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Monolith/Monolith.csproj" Aliases="monolith" />
    <ProjectReference Include="../../src/Services/Trip-Tracking/src/RutaSegura.TripTracking.Api/RutaSegura.TripTracking.Api.csproj" />
  </ItemGroup>

</Project>
