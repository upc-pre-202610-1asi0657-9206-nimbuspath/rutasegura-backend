# COPY to .env.production on the server. Replace every placeholder; never commit the resulting file.
# Run Initialize-NotificationLocal.ps1 separately to generate secret files, then copy them securely.
NOTIFICATION_SECRETS_DIR=./secrets/notification
RUTASEGURA_JWT_SECRET=REPLACE_WITH_THE_SAME_VALUE_AS_Notification_Jwt__Secret_FILE
RUTASEGURA_RABBIT_PASSWORD=REPLACE_WITH_THE_SAME_VALUE_AS_Notification_RabbitMq_PASSWORD_FILE
NOTIFICATION_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_VALUE_AS_service-token_FILE
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_ROOT_PASSWORD
MYSQL_APP_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_APPLICATION_PASSWORD
PROVISIONING_API_KEY=REPLACE_WITH_RANDOM_32_BYTE_KEY
ORS_API_KEY=
MONOLITH_IMAGE=registry.example/rutasegura/monolith:release-id
TRIP_TRACKING_IMAGE=registry.example/rutasegura/trip-tracking:release-id
NOTIFICATION_IMAGE=registry.example/rutasegura/notification:release-id
GATEWAY_IMAGE=registry.example/rutasegura/gateway:release-id
WEB_IMAGE=registry.example/rutasegura/web:release-id
APP_DOMAIN=rutasegura.example
WEB_ORIGIN=https://rutasegura.example
TLS_EMAIL=operations@example.test

APP_NETWORK_CIDR=172.30.40.0/24
NOTIFICATION_FCM_ENABLED=false
NOTIFICATION_FCM_PROJECT_ID=
NOTIFICATION_FCM_CREDENTIALS_FILE=
